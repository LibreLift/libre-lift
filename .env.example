# Public app settings only. Copy to .env; never place server credentials here.
# Hosted LibreLift development project (not production).
EXPO_PUBLIC_SUPABASE_URL=https://jibzcwwursyzvvthazby.supabase.co
# Obtain the publishable key from a maintainer or the project's API Keys page.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key

# Local alternative: replace BOTH settings with values from supabase status.
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Android emulator: use http://10.0.2.2:54321
# Physical device: use http://<computer-LAN-IP>:54321 on the same trusted network.

# No custom backend secrets are required by the health function.
# Maintainers: SUPABASE_ACCESS_TOKEN is a CLI login credential, never an Expo var.
# Keep database passwords and secret/service_role keys out of app config and Git.
